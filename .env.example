# YouCam AI Skin Analysis. Leave blank to run on labeled sample scores.
# The scan response then includes demo: true. Do not describe those scores as a live YouCam result.
YOUCAM_API_KEY=

# PayPal sandbox REST app only. Create one at https://developer.paypal.com/dashboard/applications/sandbox
# Never put live client credentials here. This server calls https://api-m.sandbox.paypal.com and nowhere else.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
